{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": false,
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/credentials.*)",
      "Read(./**/secrets.*)",
      "Read(./**/id_rsa*)",
      "Read(./**/id_ed25519*)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.development)",
      "Edit(./.env.production)",
      "Edit(./**/*.pem)",
      "Edit(./**/*.key)",
      "Edit(./**/*.p12)",
      "Edit(./**/*.pfx)",
      "Edit(./**/credentials.*)",
      "Edit(./**/secrets.*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(git clean -df*)",
      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(docker compose down -v*)",
      "Bash(docker compose down --volumes*)",
      "Bash(docker volume rm*)",
      "Bash(docker volume prune*)",
      "Bash(docker system prune*)",
      "PowerShell(Remove-Item -Recurse -Force*)"
    ],
    "ask": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git checkout main*)",
      "Bash(git switch main*)",
      "Bash(uv add*)",
      "Bash(uv remove*)",
      "Bash(pip install*)",
      "Bash(npm install*)",
      "Bash(npm i*)",
      "Bash(npx*)",
      "Bash(pnpm*)",
      "Bash(yarn*)",
      "Edit(./docs/prd/**)",
      "Edit(./docs/specs/**)",
      "Edit(./docs/adr/**)",
      "Edit(./docs/agent-harness/**)",
      "Edit(./CLAUDE.md)",
      "Edit(./.claude/settings.json)"
    ],
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git rev-parse*)",
      "Bash(git ls-files*)",
      "Bash(uv sync*)",
      "Bash(uv lock*)",
      "Bash(uv run ruff*)",
      "Bash(uv run mypy*)",
      "Bash(uv run pytest*)",
      "Bash(uv tree*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(docker compose config*)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git rev-parse*)",
      "PowerShell(uv sync*)",
      "PowerShell(uv run ruff*)",
      "PowerShell(uv run mypy*)",
      "PowerShell(uv run pytest*)"
    ]
  },
  "hooks": {
  "SessionStart": [
    {
      "hooks": [
            {
              "type": "command",
              "command": "python",
              "args": [
                "${CLAUDE_PROJECT_DIR}/.claude/hooks/session_context.py"
              ],
              "timeout": 15,
              "statusMessage": "Carregando contexto do projeto"
            }
          ]
        }
      ],
      "PreToolUse": [
        {
          "matcher": "Edit|Write|NotebookEdit|MultiEdit|Read|Bash|PowerShell",
          "hooks": [
            {
              "type": "command",
              "command": "python",
              "args": [
                "${CLAUDE_PROJECT_DIR}/.claude/hooks/protect_operations.py"
              ],
              "timeout": 15,
              "statusMessage": "Verificando operacoes protegidas"
            }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "python",
              "args": [
                "${CLAUDE_PROJECT_DIR}/.claude/hooks/verify_before_stop.py"
              ],
              "timeout": 120,
              "statusMessage": "Verificacoes rapidas"
            }
          ]
        }
      ]
    }
  }