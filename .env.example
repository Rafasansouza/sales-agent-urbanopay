# =============================================================================
# UrbanoPay Mobilidade — modelo de variáveis de ambiente
# =============================================================================
# Copie para `.env` e preencha localmente:
#   PowerShell : Copy-Item .env.example .env
#   Bash       : cp .env.example .env
#
# REGRAS OBRIGATÓRIAS
#   - Este arquivo é versionado e NUNCA pode conter credencial real.
#   - `.env` é ignorado pelo Git e nunca deve ser commitado.
#   - Nenhuma credencial pode ser exposta ao LLM (CLAUDE.md, ADR-010).
#   - Credenciais de pagamento são exclusivamente de teste (ADR-007).
# =============================================================================


# -----------------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------------
APP_ENV=local
APP_NAME=urbanopay-api
API_HOST=127.0.0.1
API_PORT=8000

# Níveis aceitos: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
# PostgreSQL — source of truth transacional (ADR-004, ADR-012)
# -----------------------------------------------------------------------------
# FONTE CANÔNICA de configuração do banco: estas variáveis são consumidas pelo
# docker-compose local em `infra/`, pela aplicação e pelo Alembic. A URL do
# SQLAlchemy (`postgresql+psycopg://...`) é derivada delas por
# `urbanopay.db.engine.build_database_url` — não existe DATABASE_URL.
POSTGRES_DB=urbanopay
POSTGRES_USER=urbanopay
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
POSTGRES_HOST=localhost
POSTGRES_PORT=5432


# -----------------------------------------------------------------------------
# Redis — estado efêmero apenas (ADR-009)
# -----------------------------------------------------------------------------
# Proibido como autoridade de saldo, Order, Payment, Fulfillment ou ledger.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0


# -----------------------------------------------------------------------------
# Identity & Cards (SPEC-002)
# -----------------------------------------------------------------------------
# Segredo do HMAC para identificadores derivados (CPF) e hashes de OTP.
# Fictício em local/CI; nunca commitar valor real. Rotacionar exige migração
# dos identificadores derivados.
IDENTITY_HASH_SECRET=CHANGE_ME_LOCAL_ONLY

# Defaults sugeridos pela SPEC-002 §2, configuráveis.
SESSION_TTL_MINUTES=30
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5


# -----------------------------------------------------------------------------
# LLM — acesso sempre via abstração de provider (ADR-010)
# -----------------------------------------------------------------------------
# Valores aceitos previstos: `fake` | `anthropic`.
# O padrão local é `fake` para que o ambiente suba sem credencial alguma.
LLM_PROVIDER=fake

# Baseline definido em ADR-010, configurável.
LLM_MODEL=claude-sonnet-5

# Preencher somente quando LLM_PROVIDER=anthropic. Nunca commitar.
ANTHROPIC_API_KEY=


# -----------------------------------------------------------------------------
# Pagamentos — Mercado Pago somente sandbox (ADR-007)
# -----------------------------------------------------------------------------
# Valores aceitos previstos: `fake` | `mercadopago`.
PAYMENT_PROVIDER=fake

# Obrigatoriamente `test`. Ambiente de produção está fora do escopo do MVP.
MERCADOPAGO_ENVIRONMENT=test

# Access token de TESTE. Fica apenas no backend, nunca no frontend nem no LLM.
MERCADOPAGO_ACCESS_TOKEN=

# Segredo usado para validar a assinatura do webhook, quando aplicável.
MERCADOPAGO_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# OpenTelemetry — telemetria transversal (ADR-008)
# -----------------------------------------------------------------------------
# Desligado por padrão: a ausência de observabilidade nunca derruba o fluxo
# de negócio, e a instrumentação chega junto com as SPECs.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=urbanopay-api

# Aponta para o otel-collector do docker-compose local.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc


# -----------------------------------------------------------------------------
# Langfuse — observabilidade de LLM/agente (ADR-008)
# -----------------------------------------------------------------------------
# Desligado por padrão e configurável por ambiente. O modo de implantação
# (self-hosted x cloud) permanece em aberto: ver docs/OPEN-QUESTIONS.md (H-05).
LANGFUSE_ENABLED=false
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=


# -----------------------------------------------------------------------------
# Limites do agente conversacional (SPEC-004 §14)
# -----------------------------------------------------------------------------
# Intencionalmente comentado. A SPEC apresenta os limites como configuráveis
# com sugestões iniciais; fixar valores aqui, antes da implementação da
# SPEC-004, equivaleria a adotar decisão de produto sem requisito aprovado.
#
# MAX_TURNS_PER_SESSION=
# MAX_LLM_CALLS_PER_TURN=
# MAX_TOOL_CALLS_PER_TURN=
# MAX_INPUT_TOKENS=
# MAX_OUTPUT_TOKENS=
# MAX_SESSION_COST=


# -----------------------------------------------------------------------------
# TTLs de domínio
# -----------------------------------------------------------------------------
# Intencionalmente ausentes. PRD §19 mantém pendentes o TTL definitivo de
# Quote/Order e a validade do QR/bilhete. Ver docs/OPEN-QUESTIONS.md (A-10).
