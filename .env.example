# =============================================================================
# UrbanoPay Mobilidade — modelo de variáveis de ambiente
# =============================================================================
# Copie para `.env` e preencha localmente:
#   PowerShell : Copy-Item .env.example .env
#   Bash       : cp .env.example .env
#
# REGRAS OBRIGATÓRIAS
#   - Este arquivo é versionado e NUNCA pode conter credencial real.
#   - `.env` é ignorado pelo Git e nunca deve ser commitado.
#   - Nenhuma credencial pode ser exposta ao LLM (CLAUDE.md, ADR-010).
#   - Credenciais de pagamento são exclusivamente de teste (ADR-007).
# =============================================================================


# -----------------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------------
APP_ENV=local
APP_NAME=urbanopay-api
API_HOST=127.0.0.1
API_PORT=8000

# Porta da interface web (ADR-011). Troque se 3000 estiver ocupada.
WEB_PORT=3000

# Painel de demonstração da interface: botão do código de verificação e
# simulação de pagamento. `false` mostra a tela como um cliente a veria.
URBANOPAY_DEMO_TOOLS=true

# Níveis aceitos: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
# PostgreSQL — source of truth transacional (ADR-004, ADR-012)
# -----------------------------------------------------------------------------
# FONTE CANÔNICA de configuração do banco: estas variáveis são consumidas pelo
# docker-compose local em `infra/`, pela aplicação e pelo Alembic. A URL do
# SQLAlchemy (`postgresql+psycopg://...`) é derivada delas por
# `urbanopay.db.engine.build_database_url` — não existe DATABASE_URL.
POSTGRES_DB=urbanopay
POSTGRES_USER=urbanopay
POSTGRES_PASSWORD=urbanopay_local_only
# Dentro do Compose o host e o nome do servico. O proprio compose.yaml
# sobrescreve esta variavel para `postgres`; o valor abaixo serve para quem
# rodar ferramentas a partir do host.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432


# -----------------------------------------------------------------------------
# Redis — fora do Compose do MVP (ADR-009, ADR-016)
# -----------------------------------------------------------------------------
# ADR-009 restringe o Redis a estado efêmero, e **não existe consumidor no
# código**. Subir um serviço que ninguém usa é infraestrutura decorativa, então
# ele não entra no `compose.yaml`. Volta quando houver rate limiting ou cache
# real.
#
# REDIS_URL=redis://redis:6379/0


# -----------------------------------------------------------------------------
# Identity & Cards (SPEC-002)
# -----------------------------------------------------------------------------
# Segredo do HMAC para identificadores derivados (CPF) e hashes de OTP.
# Fictício em local/CI; nunca commitar valor real. Rotacionar exige migração
# dos identificadores derivados.
IDENTITY_HASH_SECRET=local_only_fictitious_identity_secret

# Defaults sugeridos pela SPEC-002 §2, configuráveis.
SESSION_TTL_MINUTES=30
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5


# -----------------------------------------------------------------------------
# Orders & Payments (SPEC-003)
# -----------------------------------------------------------------------------
# Defaults fixados pela SPEC-003 §4 e §5.1, configuráveis. O TTL do Order vale
# somente enquanto ele está em DRAFT: após a confirmação explícita do cliente
# não existe expiração automática nesta versão.
QUOTE_TTL_MINUTES=10
ORDER_DRAFT_TTL_MINUTES=10


# -----------------------------------------------------------------------------
# LLM — acesso sempre via abstração de provider (ADR-010, ADR-015)
# -----------------------------------------------------------------------------
# Valores aceitos: `fake` | `openai`.
#
# O padrão é `fake`: assim `docker compose up --build` funciona num clone
# recém-feito, **sem credencial alguma**, e a demo inteira roda com respostas
# determinísticas.
#
# PARA USAR UM MODELO REAL, troque duas linhas:
#
#     LLM_PROVIDER=openai
#     OPENAI_API_KEY=<sua-chave>
#
# Sem a chave e com LLM_PROVIDER=openai a aplicação falha de forma explícita —
# nunca cai no fake em silêncio (ADR-015).
LLM_PROVIDER=fake

# Chave da OpenAI. Vive EXCLUSIVAMENTE no backend: nunca vai para HTML,
# JavaScript, browser, resposta HTTP, log, estado do grafo, banco ou
# telemetria. Nunca commitar valor real.
OPENAI_API_KEY=

# O modelo nunca é hardcoded no código.
OPENAI_MODEL=gpt-5.6-luna


# -----------------------------------------------------------------------------
# Pagamentos — Mercado Pago somente sandbox (ADR-007)
# -----------------------------------------------------------------------------
# Valores aceitos previstos: `fake` | `mercadopago`.
PAYMENT_PROVIDER=fake

# Obrigatoriamente `test`. Ambiente de produção está fora do escopo do MVP.
MERCADOPAGO_ENVIRONMENT=test

# Access token de TESTE. Fica apenas no backend, nunca no frontend nem no LLM.
MERCADOPAGO_ACCESS_TOKEN=

# Segredo usado para validar a assinatura do webhook, quando aplicável.
MERCADOPAGO_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# OpenTelemetry — telemetria transversal (ADR-008)
# -----------------------------------------------------------------------------
# Desligado por padrão: a ausência de observabilidade nunca derruba o fluxo
# de negócio, e a instrumentação chega junto com as SPECs.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=urbanopay-api

# Aponta para o otel-collector do docker-compose local.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc


# -----------------------------------------------------------------------------
# Langfuse — observabilidade de LLM/agente (ADR-008)
# -----------------------------------------------------------------------------
# Desligado por padrão e configurável por ambiente. O modo de implantação
# (self-hosted x cloud) permanece em aberto: ver docs/OPEN-QUESTIONS.md (H-05).
LANGFUSE_ENABLED=false
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=


# -----------------------------------------------------------------------------
# Limites do agente conversacional (SPEC-004 §14)
# -----------------------------------------------------------------------------
# Os dois limites abaixo possuem consumidor real na Etapa 2 e por isso saíram
# de "comentado". Os demais seguem sem consumidor: fixá-los produziria
# configuração sem efeito (SPEC-004 §22).
MAX_TOOL_CALLS_PER_TURN=5
MAX_LLM_CALLS_PER_TURN=4

# TTL da conversa (ADR-014, D-3). Deslizante e avaliado na leitura. Não é regra
# de negócio: é parâmetro de retenção.
CONVERSATION_TTL_MINUTES=1440

# Ainda sem consumidor:
# MAX_TURNS_PER_SESSION=
# MAX_INPUT_TOKENS=
# MAX_OUTPUT_TOKENS=
# MAX_SESSION_COST=


# -----------------------------------------------------------------------------
# TTLs de domínio ainda sem decisão
# -----------------------------------------------------------------------------
# O TTL de Quote e de Order em DRAFT foi resolvido (A-10) e está na seção
# "Orders & Payments" acima. Permanece pendente apenas a validade do
# QR/bilhete, que pertence à SPEC-005 — PRD §19.
#
# TICKET_VALIDITY_MINUTES=
